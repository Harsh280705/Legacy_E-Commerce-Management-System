# Copy to .env and set a strong local password. Never commit .env.
# SQL Server (Developer edition in container) requires 8+ chars with
# upper, lower, digit and symbol.
DB_PASSWORD=ChangeMe!234567890abc
SEED_SIZE=100

# Optional administrator bootstrap (local/dev only, never commit real values).
# BOTH must be set, otherwise no Admin role/user is provisioned and /Admin is
# unreachable. Leave them blank on any public deployment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
