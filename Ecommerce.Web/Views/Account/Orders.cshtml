@model System.Collections.Generic.IList<Ecommerce.Core.ViewModels.OrderHistoryItemViewModel>
@{ ViewBag.Title = "Orders"; }
<div class="container yb-page">
    <h1>Order history</h1>
    @if (Model.Count == 0) { <p class="text-muted">No orders yet.</p> }
    else {
        <table class="table"><thead><tr><th>Order</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th></tr></thead>
        <tbody>@foreach (var o in Model) { <tr><td><a href="/Checkout/Success?orderNumber=@o.OrderNumber">@o.OrderNumber</a></td><td>@o.CreatedUtc.ToString("yyyy-MM-dd")</td><td>@o.ItemCount</td><td>&#8377;@o.GrandTotal.ToString("N2")</td><td>@o.Status</td></tr> }</tbody></table>
    }
</div>
