@model Ecommerce.Core.ViewModels.RegisterViewModel
@{ ViewBag.Title = "Register"; }
<div class="container yb-page yb-narrow">
    <div class="yb-crumb"><a href="/">Home</a> &rsaquo; Register</div>
    <div class="yb-page-head"><h1>Create your account</h1><p>Join free — track orders and check out faster.</p></div>
    <div class="yb-form yb-auth-wrap">
        <div class="yb-auth-side">
            <h2>Shop smarter, together</h2>
            <p>Members enjoy a smoother store.</p>
            <ul><li>Order history in one place</li><li>Saved delivery details</li><li>Member-only festive edits</li></ul>
        </div>
        <div class="yb-auth-form">
            @using (Html.BeginForm("Register", "Account", FormMethod.Post)) {
                @Html.Raw(Context.Items["AF_TOKEN_HTML"])
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group"><label>First name</label>@Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "e.g. Priya" })@Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })</div>
                <div class="form-group"><label>Last name</label>@Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "e.g. Sharma" })@Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })</div>
                <div class="form-group"><label>Email</label>@Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "you@example.in" })@Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })</div>
                <div class="form-group"><label>Password (min 6 chars)</label>@Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Choose a password" })@Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })</div>
                <button class="btn btn-primary btn-block btn-lg" type="submit">Create account</button>
            }
            <p class="yb-auth-alt">Have an account? <a href="/Account/Login">Login</a></p>
        </div>
    </div>
</div>
