@model Ecommerce.Core.ViewModels.AdminDashboardViewModel
@{ ViewBag.Title = "Admin dashboard"; }
<div class="container yb-page">
    <h1>Admin dashboard</h1>
    <p><a href="/Admin/Products">Manage products</a> &middot; <a href="/">Back to store</a></p>
    <div class="yb-stats">
        <div class="yb-stat"><span class="yb-stat-num">@Model.TotalProducts</span><span class="yb-stat-lbl">Products (@Model.ActiveProducts active / @Model.InactiveProducts inactive)</span></div>
        <div class="yb-stat"><span class="yb-stat-num">@Model.TotalCategories</span><span class="yb-stat-lbl">Categories</span></div>
        <div class="yb-stat"><span class="yb-stat-num">@Model.LowStockProducts</span><span class="yb-stat-lbl">Low stock (&lt; @Model.LowStockThreshold)</span></div>
        <div class="yb-stat"><span class="yb-stat-num">@Model.OutOfStockProducts</span><span class="yb-stat-lbl">Out of stock</span></div>
        <div class="yb-stat"><span class="yb-stat-num">@Model.TotalOrders</span><span class="yb-stat-lbl">Orders (@Model.PendingOrders pending / @Model.CompletedOrders completed)</span></div>
        <div class="yb-stat"><span class="yb-stat-num">@Model.TotalUnitsSold</span><span class="yb-stat-lbl">Units sold</span></div>
        <div class="yb-stat"><span class="yb-stat-num">&#8377;@Model.TotalRecordedSales.ToString("N2")</span><span class="yb-stat-lbl">Recorded sales</span></div>
    </div>
    <div class="yb-metric-rules">
        <strong>Metric rules:</strong> units sold = SUM(OrderLines.Quantity); recorded sales = SUM(OrderLines.LineTotal)
        at purchase-time prices; qualifying orders exclude Cancelled/Refunded; pending = Placed; completed = Shipped/Delivered/Completed.
        The store currently only creates Placed orders, so completed counts are 0 until fulfilment statuses exist.
    </div>
    <div class="row">
        <div class="col-sm-6">
            <h2>Best sellers (actual order lines)</h2>
            @if (Model.BestSellers.Count == 0) { <p class="text-muted">No qualifying sales yet.</p> }
            else {
            <table class="table"><thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead><tbody>
            @foreach (var b in Model.BestSellers) { <tr><td><a href="/Admin/Product/@b.ProductId">@b.ProductName</a></td><td>@b.UnitsSold</td><td>&#8377;@b.Revenue.ToString("N2")</td></tr> }
            </tbody></table>
            }
        </div>
        <div class="col-sm-6">
            <h2>Recent orders</h2>
            @if (Model.RecentOrders.Count == 0) { <p class="text-muted">No orders yet.</p> }
            else {
            <table class="table"><thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th></tr></thead><tbody>
            @foreach (var o in Model.RecentOrders) { <tr><td>@o.OrderNumber</td><td>@o.CreatedUtc.ToString("yyyy-MM-dd")</td><td>&#8377;@o.GrandTotal.ToString("N2")</td><td>@o.Status</td></tr> }
            </tbody></table>
            }
        </div>
    </div>
    <h2>Sales by day (last 14 days)</h2>
    @if (Model.SalesByDay.Count == 0) { <p class="text-muted">No qualifying sales in the last 14 days.</p> }
    else {
    <div class="table-responsive"><table class="table"><thead><tr><th>Day (UTC)</th><th>Orders</th><th>Units</th><th>Revenue</th></tr></thead><tbody>
    @foreach (var d in Model.SalesByDay) { <tr><td>@d.Day.ToString("yyyy-MM-dd")</td><td>@d.Orders</td><td>@d.Units</td><td>&#8377;@d.Revenue.ToString("N2")</td></tr> }
    </tbody></table></div>
    }
</div>
