@model Ecommerce.Core.ViewModels.CategoryPageViewModel
@{
    ViewBag.Title = Model.Name;
    int size = ViewBag.Size != null ? (int)ViewBag.Size : 12;
    string mode = (ViewBag.Mode as string) ?? "pagination";
    string sort = (Model.Sort as string) ?? "recommended";
    bool hasMore = Model.Page * Model.PageSize < Model.TotalCount;
    string hasMoreJs = hasMore ? "true" : "false";
    string pagPressed = mode == "pagination" ? "true" : "false";
    string infPressed = mode == "infinite" ? "true" : "false";
    var cats = ViewBag.Categories as System.Collections.Generic.IList<Ecommerce.Core.ViewModels.CategoryNavViewModel>;
}
@functions {
    public string CatIcon(string slug) {
        slug = (slug ?? "").ToLowerInvariant();
        if (slug.Contains("footwear")) return "footwear";
        if (slug.Contains("fashion")) return "fashion";
        if (slug.Contains("decor")) return "decor";
        if (slug.Contains("kitchen") || slug.Contains("home")) return "home";
        if (slug.Contains("electronic") || slug.Contains("audio") || slug.Contains("mobile")) return "tech";
        if (slug.Contains("beauty")) return "beauty";
        if (slug.Contains("sport") || slug.Contains("fitness")) return "sports";
        if (slug.Contains("book")) return "books";
        if (slug.Contains("toy")) return "toys";
        return "placeholder";
    }
}
<div class="container yb-page">
    <div class="yb-crumb"><a href="/">Home</a> &rsaquo; <a href="/Catalog/Index">Shop</a> &rsaquo; @Model.Name</div>
    <div class="yb-page-head">
        <h1>@Model.Name</h1>
        @if (!string.IsNullOrEmpty(Model.Description)) { <p>@Model.Description</p> }
        else { <p>@Model.TotalCount hand-picked products in this department.</p> }
    </div>
    @if (Model.ChildCategories.Count > 0) {
        <div class="yb-cat-tiles yb-cat-tiles-sm">
            @foreach (var c in Model.ChildCategories) { <a class="yb-tile" href="/c/@c.Slug"><span class="yb-tile-ic"><img src="/Images/@(CatIcon(c.Slug)).png" alt="" loading="lazy" /></span><span class="yb-tile-tx"><strong>@c.Name</strong>@if (c.ProductCount > 0) { <span>@c.ProductCount products</span> }</span><span class="yb-tile-go" aria-hidden="true">&rarr;</span></a> }
        </div>
    }
    <div class="row">
    <aside class="col-sm-3">
        <div class="yb-side-card">
            <h3>Departments</h3>
            <div class="list-group" id="cat-nav">
                @if (cats != null) {
                    foreach (var c in cats) {
                        <a href="/c/@c.Slug" class="list-group-item" data-cat="@c.CategoryId">@c.Name <span class="badge">@c.ProductCount</span></a>
                        foreach (var ch in c.Children) {
                            <a href="/c/@ch.Slug" class="list-group-item yb-sub" data-cat="@ch.CategoryId">&mdash; @ch.Name</a>
                        }
                    }
                }
            </div>
        </div>
    </aside>
    <div class="col-sm-9">
    <div class="yb-filterbar">
        <p class="text-muted yb-result-count" role="status"><strong>@Model.TotalCount product(s)</strong> in @Model.Name</p>
        <form method="get" class="yb-filters" id="filter-form" aria-label="Product filters">
            <select name="sort" class="form-control" id="sort-sel" aria-label="Sort products">
                <option value="recommended" @(sort=="recommended"?"selected":"")>Recommended</option>
                <option value="name_asc" @(sort=="name_asc"?"selected":"")>Name A–Z</option>
                <option value="name_desc" @(sort=="name_desc"?"selected":"")>Name Z–A</option>
                <option value="price_asc" @(sort=="price_asc"?"selected":"")>Price low–high</option>
                <option value="price_desc" @(sort=="price_desc"?"selected":"")>Price high–low</option>
                <option value="newest" @(sort=="newest"?"selected":"")>Newest</option>
            </select>
            <select name="size" class="form-control" id="size-sel" aria-label="Products per page">
                <option value="12" @(size==12?"selected":"")>12 / page</option>
                <option value="24" @(size==24?"selected":"")>24 / page</option>
            </select>
            <input type="hidden" name="mode" value="@mode" />
            <button class="btn btn-default" type="submit">Sort</button>
        </form>
        <div class="btn-group yb-mode-toggle" role="group" aria-label="Browsing mode">
            <a href="/c/@Model.Slug?sort=@sort&size=@size&mode=pagination" class="btn btn-default btn-sm @(mode=="pagination"?"active":"")" aria-pressed="@pagPressed">Pagination</a>
            <a href="/c/@Model.Slug?sort=@sort&size=@size&mode=infinite" class="btn btn-default btn-sm @(mode=="infinite"?"active":"")" aria-pressed="@infPressed">Infinite scroll</a>
        </div>
    </div>
    <div id="product-grid">@Html.Partial("_ProductGrid", Model.Products)</div>
    @if (mode == "pagination") {
    <nav aria-label="Pages"><ul class="pagination" id="pager">
        @if (Model.Page > 1) { <li><a href="/c/@Model.Slug?sort=@sort&size=@size&mode=pagination&page=@(Model.Page-1)" data-page="@(Model.Page-1)" aria-label="Previous page">&laquo;</a></li> }
        @for (int i = 1; i <= Model.TotalPages && i <= 20; i++) {
            <li class="@(i==Model.Page?"active":"")"><a href="/c/@Model.Slug?sort=@sort&size=@size&mode=pagination&page=@i" data-page="@i" aria-label="Page @i">@i</a></li>
        }
                    @if (Model.Page < Model.TotalPages) { <li><a href="/c/@Model.Slug?sort=@sort&size=@size&mode=pagination&page=@(Model.Page+1)" data-page="@(Model.Page+1)" aria-label="Next page">&raquo;</a></li> }
    </ul></nav>
    } else {
    <div id="infinite-zone" class="yb-infinite" data-next="@(Model.Page + 1)" data-hasmore="@hasMoreJs">
        <div id="infinite-status" class="text-muted" role="status"></div>
        <button type="button" id="load-more" class="btn btn-default btn-lg btn-block">Load more</button>
    </div>
    }
    </div><!-- /.col-sm-9 -->
    </div><!-- /.row -->
</div>
@section scripts { <script>YB_GRID = { slug: '@Model.Slug', sort: '@sort', size: @size, mode: '@mode', page: @Model.Page, hasMore: @hasMoreJs };</script> }
