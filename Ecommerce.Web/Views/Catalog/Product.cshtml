@model Ecommerce.Core.ViewModels.ProductDetailViewModel
@{ ViewBag.Title = Model.Name; }
<div class="container yb-page">
    <ol class="breadcrumb"><li><a href="/">Home</a></li><li><a href="/c/@Model.CategorySlug">@Model.CategoryName</a></li><li class="active">@Model.Name</li></ol>
    <div class="row">
        <div class="col-sm-6">
            <div class="yb-gallery">
                <img id="main-img" src="@(Model.Images.Count>0?Model.Images[0].ImageUrl:"/Images/placeholder.png")" alt="@Model.Name" onerror="this.src='/Images/placeholder.png'" />
                <div class="yb-thumbs">
                    @foreach (var im in Model.Images) { <img src="@im.ImageUrl" alt="@im.AltText" class="yb-thumb-sel" onerror="this.src='/Images/placeholder.png'" /> }
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <h1>@Model.Name</h1>
            <p class="text-muted">@Model.ShortDescription</p>
            <div class="yb-price-lg"><strong id="buy-price">&#8377;@Model.Price.ToString("N2")</strong>
                @if (Model.CompareAtPrice.HasValue) { <s>&#8377;@Model.CompareAtPrice.Value.ToString("N2")</s> <span class="yb-badge">-@Model.DiscountPct%</span> }
            </div>
            <p id="buy-stock">@if (Model.InStock) { <span class="label label-success">In stock (@Model.StockQuantity)</span> } else { <span class="label label-danger">Out of stock</span> }</p>
            <p>@Model.Description</p>
            @if (Model.InStock) {
                <form method="post" action="/Cart/Add" class="form-inline" id="buy-form">
                    @Html.Raw(Context.Items["AF_TOKEN_HTML"])
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    @if (Model.Variants.Count > 0) {
                        <div class="form-group">
                            <label for="variantId">Variant</label>
                            <select name="variantId" id="variantId" class="form-control" data-base-price="@Model.Price">
                                @foreach (var v in Model.Variants) { <option value="@v.VariantId" data-adj="@(v.PriceAdjustment ?? 0)" data-stock="@v.Stock">@v.Name: @v.Value @(v.PriceAdjustment.HasValue && v.PriceAdjustment != 0 ? "(" + (v.PriceAdjustment > 0 ? "+" : "") + v.PriceAdjustment.Value.ToString("N2") + ")" : "")</option> }
                            </select>
                        </div>
                    }
                    <div class="form-group"><label for="quantity">Qty</label><input type="number" name="quantity" id="quantity" value="1" min="1" max="99" class="form-control" /></div>
                    <button type="submit" class="btn btn-primary btn-lg" data-add="@Model.ProductId" data-name="@Model.Name">Add to cart</button>
                </form>
            }
        </div>
    </div>
    @if (Model.Related.Count > 0) {
        <h2>You may also like</h2>
        @Html.Partial("_ProductGrid", Model.Related)
    }
</div>
