@model Ecommerce.Core.ViewModels.ProductDetailViewModel
@{ ViewBag.Title = Model.Name; }
<div class="container yb-page">
    <div class="yb-crumb"><a href="/">Home</a> &rsaquo; <a href="/c/@Model.CategorySlug">@Model.CategoryName</a> &rsaquo; @Model.Name</div>
    <div class="row">
        <div class="col-sm-6">
            <div class="yb-gallery">
                <img id="main-img" src="@(Model.Images.Count>0?Model.Images[0].ImageUrl:"/Images/placeholder.png")" alt="@Model.Name" fetchpriority="high" decoding="async" onerror="this.onerror=null;this.src='/Images/placeholder.png'" />
                <div class="yb-thumbs">
                    @{ int ti = 0; }
                    @foreach (var im in Model.Images) { <img src="@im.ImageUrl" alt="@im.AltText" class="yb-thumb-sel@(ti++==0?" yb-thumb-on":"")" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/Images/placeholder.png'" /> }
                </div>
            </div>
        </div>
        <div class="col-sm-6 yb-detail-info">
            <div class="yb-detail-cat"><a href="/c/@Model.CategorySlug">@Model.CategoryName</a></div>
            <h1>@Model.Name</h1>
            <p class="yb-detail-short">@Model.ShortDescription</p>
            <div class="yb-price-block">
                <span class="yb-price-lg"><span id="buy-price">&#8377;@Model.Price.ToString("N2")</span>
                @if (Model.CompareAtPrice.HasValue) { <s>&#8377;@Model.CompareAtPrice.Value.ToString("N2")</s> }</span>
                @if (Model.DiscountPct.HasValue) { <span class="yb-badge yb-save">Save @Model.DiscountPct%</span> }
            </div>
            <p id="buy-stock" class="yb-stock">@if (Model.InStock) { <span class="label label-success">In stock (@Model.StockQuantity)</span> } else { <span class="label label-danger">Out of stock</span> }</p>
            <p class="yb-detail-desc">@Model.Description</p>
            @if (Model.InStock) {
                <form method="post" action="/Cart/Add" class="form-inline" id="buy-form">
                    @Html.Raw(Context.Items["AF_TOKEN_HTML"])
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    @if (Model.Variants.Count > 0) {
                        <div class="form-group">
                            <label for="variantId">Variant</label>
                            <select name="variantId" id="variantId" class="form-control" data-base-price="@Model.Price">
                                @foreach (var v in Model.Variants) { <option value="@v.VariantId" data-adj="@(v.PriceAdjustment ?? 0)" data-stock="@v.Stock">@v.Name: @v.Value @(v.PriceAdjustment.HasValue && v.PriceAdjustment != 0 ? "(" + (v.PriceAdjustment > 0 ? "+" : "") + v.PriceAdjustment.Value.ToString("N2") + ")" : "")</option> }
                            </select>
                        </div>
                    }
                    <div class="form-group"><label for="quantity">Qty</label><input type="number" name="quantity" id="quantity" value="1" min="1" max="99" class="form-control" /></div>
                    <button type="submit" class="btn btn-primary btn-lg" data-add="@Model.ProductId" data-name="@Model.Name">Add to cart</button>
                </form>
            }
            <ul class="yb-detail-perks">
                <li>Cash on delivery available</li>
                <li>Free standard shipping over &#8377;75</li>
                <li>Easy returns — see <a href="/Home/Returns">Returns</a></li>
            </ul>
        </div>
    </div>
    @if (Model.Related.Count > 0) {
        <div class="yb-related">
            <div class="yb-sec-head"><div><span class="yb-eyebrow">Keep exploring</span><h2>You may also like</h2><p>More from @Model.CategoryName.</p></div><a href="/c/@Model.CategorySlug">More &rarr;</a></div>
            @Html.Partial("_ProductGrid", Model.Related)
        </div>
    }
</div>
