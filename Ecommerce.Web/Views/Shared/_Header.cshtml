@using Ecommerce.Core.ViewModels
@{
    var cats = ViewBag.Categories as System.Collections.Generic.IList<CategoryNavViewModel>;
}
<header class="yb-top">
    <div class="yb-top-inner">
        <a class="yb-brand" href="/">Yantra<span>Bazaar</span></a>
        <span class="yb-now">@(ViewBag.Title ?? "Home")</span>
        <form class="yb-search" method="get" action="/Catalog/Index" role="search">
            <div class="input-group">
                <input type="text" name="q" class="form-control" placeholder="Search kurtas, sneakers, lamps..." value="@(ViewBag.Query ?? "")" aria-label="Search products" />
                <span class="input-group-btn"><button class="btn btn-primary" type="submit">Search</button></span>
            </div>
        </form>
        <ul class="yb-actions">
            <li><a href="/Catalog/Index">Shop</a></li>
            @if (Request.IsAuthenticated) {
                <li><a href="/Account/Profile">Hi, @User.Identity.Name.Split('@')[0]</a></li>
                <li><a href="/Account/Orders">Orders</a></li>
                if (User.IsInRole("Admin")) {
                    <li><a href="/Admin">Admin</a></li>
                }
                <li>
                    <form method="post" action="/Account/LogOff" class="yb-logoff">@Html.Raw(Context.Items["AF_TOKEN_HTML"])<button type="submit" class="btn btn-link">Logout</button></form>
                </li>
            } else {
                <li><a href="/Account/Login">Login</a></li>
                <li><a href="/Account/Register" class="btn btn-primary yb-join">Join</a></li>
            }
            <li id="mini-cart-slot"><a href="/Cart/Index" id="mini-cart-btn" class="yb-cart-link" aria-haspopup="true" aria-expanded="false" aria-controls="mini-cart-panel">Cart<span class="yb-cart-count" id="cart-count">0</span></a></li>
        </ul>
        <div id="mini-cart-panel" class="yb-minicart-panel" style="display:none">
            <div id="mini-cart-body"><p class="yb-empty">Loading cart...</p></div>
        </div>
    </div>
    @if (cats != null) {
    <nav class="yb-catbar" aria-label="Categories">
        <div class="yb-catbar-inner">
            @foreach (var c in cats) {
                <div class="yb-cat">
                    <a href="/c/@c.Slug">@c.Name</a>
                    @if (c.Children.Count > 0) {
                        <div class="yb-drop">
                            @foreach (var ch in c.Children) { <a href="/c/@ch.Slug">@ch.Name</a> }
                        </div>
                    }
                </div>
            }
        </div>
    </nav>
    }
</header>
@Html.Raw(Context.Items["AF_TOKEN_HTML"])
