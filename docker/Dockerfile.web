# LegacyEcommerce web image: builds the .NET Framework 4.7 / MVC5 solution with
# Mono's MSBuild inside a container (host toolchain untouched), then serves it
# with XSP4. Multi-stage so NuGet/build tools don't ship in the runtime layer.
#
# NOTE (verified 2026-10-11): mono:6.12 images are Debian Buster based and the
# stock deb.debian.org Buster repos are archived; apt sources are repointed to
# archive.debian.org below. Smallest verified change, no newer base image.
ARG MONO_TAG=6.12

# ---------- builder (no apt needed: msbuild + curl + nuget ship in mono:6.12) ----------
FROM mono:${MONO_TAG} AS builder
WORKDIR /src
RUN curl -sSL -o /usr/local/bin/nuget.exe https://dist.nuget.org/win-x86-commandline/v5.11.0/nuget.exe \
    && printf '#!/bin/sh\nexec mono /usr/local/bin/nuget.exe "$@"\n' > /usr/local/bin/nuget5 \
    && chmod +x /usr/local/bin/nuget5
COPY . .
RUN mono /usr/local/bin/nuget.exe restore LegacyEcommerce.sln \
    && msbuild /p:Configuration=Release /p:MvcBuildViews=false /verbosity:minimal LegacyEcommerce.sln

# ---------- runtime ----------
FROM mono:${MONO_TAG}-slim AS runtime
WORKDIR /app
RUN sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g; s|http://deb.debian.org/debian-security|http://archive.debian.org/debian-security|g' /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends mono-xsp4 curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/Ecommerce.Web/. /app/
# Guard against Mono MSBuild resolving the WebStack to its GAC 2.0 copies:
# always ship the exact NuGet 3.2.7/5.2.7 binaries (verified 2026-10-11).
COPY --from=builder /src/packages/Microsoft.AspNet.Mvc.5.2.7/lib/net45/System.Web.Mvc.dll /app/bin/System.Web.Mvc.dll
COPY --from=builder /src/packages/Microsoft.AspNet.Razor.3.2.7/lib/net45/System.Web.Razor.dll /app/bin/System.Web.Razor.dll
COPY --from=builder /src/packages/Microsoft.AspNet.WebPages.3.2.7/lib/net45/System.Web.WebPages.dll /app/bin/System.Web.WebPages.dll
COPY --from=builder /src/packages/Microsoft.AspNet.WebPages.3.2.7/lib/net45/System.Web.WebPages.Razor.dll /app/bin/System.Web.WebPages.Razor.dll
COPY docker/web-entrypoint.sh /usr/local/bin/web-entrypoint.sh
RUN chmod +x /usr/local/bin/web-entrypoint.sh
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -fsS http://localhost:8080/health || exit 1
ENTRYPOINT ["/usr/local/bin/web-entrypoint.sh"]
